<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>SignalR hub filter that audits every state-changing hub call with the calling panel's IP, user agent and hostname.</Description>
        <PackageId>AVCoders.SignalR.Audit</PackageId>
        <AssemblyName>AVCoders.SignalR.Audit</AssemblyName>
        <RootNamespace>AVCoders.SignalR.Audit</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Core\Core.csproj" />
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>
