<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>AVCoders.Core</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Foundation for the AV Coders device library: LogBase logging with in-memory diagnostics buffers and tracing, DeviceBase power/communication state, and the CommunicationClient and VolumeControl abstractions shared by every driver.</Description>
        <PackageId>AVCoders.Core</PackageId>
        <AssemblyName>AVCoders.Core</AssemblyName>
        <LangVersion>default</LangVersion>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="AVCoders.Core.Tests" />
      <InternalsVisibleTo Include="AVCoders.CommunicationClients" />
      <InternalsVisibleTo Include="AVCoders.CommunicationClients.Tests" />
      <InternalsVisibleTo Include="AVCoders.Annotator" />
      <InternalsVisibleTo Include="AVCoders.Camera" />
      <InternalsVisibleTo Include="AVCoders.Display" />
      <InternalsVisibleTo Include="AVCoders.Dsp" />
      <InternalsVisibleTo Include="AVCoders.Matrix" />
      <InternalsVisibleTo Include="AVCoders.MediaPlayer" />
      <InternalsVisibleTo Include="AVCoders.Power" />
      <InternalsVisibleTo Include="WirelessPresenter" />
    </ItemGroup>

</Project>
